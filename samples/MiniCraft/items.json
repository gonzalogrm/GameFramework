// Objetos de MiniCraft como PROTOTIPOS con herencia multiple. Se cargan al arrancar (ItemTypes.Load); los tipos de entidad (entitytypes.json) los
// referencian por NOMBRE en sus inventarios y equipamiento, y las entidades solo guardan ese ID: un prototipo lo comparten miles de entidades.
//
//   name         clave (lo que se guarda)
//   parents      de que prototipos hereda, EN ORDEN. Si dos padres tienen la misma propiedad, vale la del ULTIMO (el siguiente "knife" hereda de
//                item y de weapon: su categoria es la de weapon). Las propiedades propias mandan sobre todas las heredadas
//   abstract     solo sirve de base: no es un objeto (no tiene ID)
//   components   componentes (comportamientos) del objeto, heredados por los hijos: ["thorns", "regeneration"]. Cada nombre lo asocia el juego a codigo
//                (ItemBehaviors.cs): eventos que recibe el que lo lleva equipado, efectos por tick...
//   properties   valores por defecto (10.0 decimal, 10 entero, "texto", true). Las que entiende el motor:
//                  title, category, max_stack (por defecto 64; 1 si es equipable), slot (tipo de ranura: hand, head, chest, feet, ring...),
//                  attack, defense (suman al estar equipado), use_<efecto> (consumible: use_heal = 3 cura 3)
//                Cualquier otra sirve para tu logica (se consulta con ItemDef.Get)
//   VARIANTES EN PARTIDA: de CUALQUIER objeto que no sea abstracto se pueden crear variantes en tiempo de ejecucion (ItemCatalog.CreateRuntime): cambian
//                propiedades, anaden propiedades nuevas y componentes, o heredan de mas prototipos. Se guardan con el mundo (solo el delta)
//   atajos       title, category, maxStack, slot, attack, defense y use: [{ "effect": "heal", "amount": 3 }] equivalen a esas propiedades
{
  "items": [
    // ======================= prototipos base =======================
    { "name": "item", "abstract": true, "properties": { "title": "", "category": "misc", "max_stack": 64 } },

    { "name": "ingredient", "abstract": true, "parents": ["item"], "properties": { "category": "ingredient" } },

    { "name": "consumable", "abstract": true, "parents": ["item"], "properties": { "max_stack": 16 } },
    { "name": "food",   "abstract": true, "parents": ["consumable"], "properties": { "category": "food", "max_stack": 32 } },
    { "name": "potion", "abstract": true, "parents": ["consumable"], "properties": { "category": "potion", "max_stack": 8 } },

    { "name": "equipment", "abstract": true, "parents": ["item"], "properties": { "max_stack": 64 } },
    { "name": "weapon", "abstract": true, "parents": ["equipment"], "properties": { "slot": "hand", "category": "weapon", "attack": 1.0 } },
    { "name": "armor",  "abstract": true, "parents": ["equipment"], "properties": { "category": "armor", "defense": 1.0 } },

    // ======================= ingredientes =======================
    { "name": "bone",          "parents": ["ingredient"], "title": "Hueso" },
    { "name": "rotten_flesh",  "parents": ["ingredient"], "title": "Carne podrida" },
    { "name": "healing_herb",  "parents": ["ingredient"], "title": "Hierba curativa" },

    // ======================= comida y pociones =======================
    { "name": "apple",         "parents": ["food"],   "title": "Manzana", "properties": { "max_stack": 16, "use_heal": 3.0 } },
    { "name": "berries",       "parents": ["food"],   "title": "Bayas",   "properties": { "use_heal": 1.0 } },
    { "name": "health_potion", "parents": ["potion"], "title": "Pocion de vida", "properties": { "use_heal": 10.0 } },

    // ======================= armas (ranura "hand") =======================
    { "name": "club",       "parents": ["weapon"], "title": "Garrote",          "properties": { "attack": 1.5 } },
    { "name": "wood_sword", "parents": ["weapon"], "title": "Espada de madera", "properties": { "attack": 2.0 } },
    { "name": "iron_sword", "parents": ["weapon"], "title": "Espada de hierro", "properties": { "attack": 4.0 } },

    // Herencia MULTIPLE: hereda de item y de weapon (en ese orden: lo que tengan en comun lo pone weapon). En partida se crean variantes de el
    // (el cuchillo unico de un lider, las armas legendarias...): ver EnemySpawner y LegendaryRegistry.
    { "name": "knife", "parents": ["item", "weapon"], "title": "Cuchillo", "properties": { "attack": 2.5 } },

    // ======================= armaduras =======================
    { "name": "leather_cap",   "parents": ["armor"], "title": "Gorro de cuero",  "properties": { "slot": "head",  "defense": 1.0 } },
    { "name": "leather_vest",  "parents": ["armor"], "title": "Peto de cuero",   "properties": { "slot": "chest", "defense": 2.0 } },
    { "name": "leather_boots", "parents": ["armor"], "title": "Botas de cuero",  "properties": { "slot": "feet",  "defense": 1.0 } },
    { "name": "iron_helmet",   "parents": ["armor"], "title": "Casco de hierro", "properties": { "slot": "head",  "defense": 2.0 } },

    // ======================= accesorios =======================
    { "name": "lucky_ring", "parents": ["equipment"], "title": "Anillo de la suerte",
      "properties": { "slot": "ring", "category": "accessory", "attack": 0.5, "defense": 0.5 } }
  ]
}
