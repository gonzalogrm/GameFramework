// Configuracion del mundo de MiniCraft. Edita los valores y pulsa "Nuevo mundo" en el menu.
// "Continuar" usa la configuracion guardada con ese mundo (no se puede cambiar el terreno de un mundo ya generado).
// Si un valor esta fuera de rango se ajusta y el menu principal lo avisa.
// Tamanos y distancias en BLOQUES. Amplitudes en fraccion de la altura total del mundo.
{
  // ---------- ESCALA ----------
  "MapWidth": 200, // regiones en X (8..2000). El mundo se envuelve: este y oeste se conectan
  "MapHeight": 100, // regiones en Z, de polo a polo (4..500)
  "RegionChunksX": 4, // chunks por region en X (1..256). Anchura del mundo = MapWidth * RegionChunksX * ChunkSize
  "RegionChunksZ": 4,
  "ChunkSize": 32, // 8, 16 o 32
  "VerticalChunks": 3, // CHUNKS EN VERTICAL (2..32). Altura del mundo = VerticalChunks * ChunkSize. 4 -> 64 bloques, 8 -> 128, 16 -> 256

  // ---------- RELIEVE ----------
  "SeaLevelFraction": 0.1, // nivel del mar como fraccion de la altura (0.1..0.9)
  "ContinentSize": 50000, // TAMANO DE LOS CONTINENTES (500..100000). Mayor = continentes mas grandes
  "MountainSize": 8000, // anchura de las cordilleras (200..50000); la altura de sus crestas se reparte en varias octavas
  "DetailSize": 100, // tamano del detalle del suelo (10..2000)
  "ContinentAmplitude": 0.50, // profundidad de los mares (fraccion de la altura, 0..1)
  "MountainAmplitude": 0.70, // altura de las cordilleras sobre la llanura (fraccion de la tierra emergida disponible, 0..1.5)
  "DetailAmplitude": 0.10, // relieve fino del suelo (fraccion de la altura, 0..0.5). Poco: las llanuras deben ser llanas
  "LandBias": 0.00, // -0.5..0.5. Positivo = mas tierra, negativo = mas oceano
  "ContinentOctaves": 4, // capas de ruido (1..8). Mas capas = bordes mas irregulares, algo mas lento
  "MountainOctaves": 4, // capas de las crestas: mas = aristas y picos mas finos
  "DetailOctaves": 4,
  // ----- Relieve: llanuras, colinas, cordilleras subitas, mesetas, lagos, rios y valles -----
  "RangeCoverage": 0.15, // fraccion de la tierra cubierta por cordilleras (0..0.6). El resto: llanuras, colinas y mesetas
  "RangeSharpness": 0.30, // brusquedad del pie de las cordilleras (0.02..0.6). Menor = mas subito
  "RangeWarp": 3000, // deformacion (domain warping) de las cordilleras en bloques (0..3000). Mas = mas sinuosas y menos redondas
  "HillSize": 1000, // tamano de las colinas
  "HillAmplitude": 0.30, // altura de las colinas (fraccion de la altura del mundo)
  "HillRegionSize": 5000, // tamano de las regiones con colinas (entre ellas, llanura)
  "PlateauHeight": 5, // salto de las mesetas (acantilados), en bloques
  "Terracing": 0.50, // 0..1: terrazas escalonadas en algunas regiones
  "RiverSpacing": 10000, // separacion tipica de los rios
  "RiverWidth": 60, // anchura del cauce en bloques
  "ValleyWidth": 40, // anchura del valle a cada lado del rio
  "ValleyDepth": 0.50, // 0..1: cuanto baja el terreno hacia el rio
  "Lakes": 0.10, // 0..1: cantidad de lagos en las llanuras
  "MinHeightFraction": 0.05, // fondo marino minimo (fraccion de la altura)
  "MaxHeightFraction": 0.95, // cumbre maxima (fraccion de la altura)

  // ---------- CLIMA Y BIOMAS ----------
  "TemperatureNoiseSize": 8000, // tamano de las manchas de temperatura
  "HumidityNoiseSize": 8000, // tamano de las manchas de humedad
  "LatitudeWeight": 0.8, // 0..1. Cuanto manda la latitud (frio en los polos, calor en el ecuador)
  "AltitudeCooling": 0.4, // 0..1. Cuanto enfria la altura
  "ClimateWarmth": 0.0, // -0.5..0.5. Sube o baja todas las temperaturas (mas desiertos / mas tundra)
  "ClimateWetness": 0.0, // -0.5..0.5. Sube o baja toda la humedad (mas junglas / mas desiertos)
  "BeachHeight": 1, // bloques de playa sobre el nivel del mar (0..6)
  "MountainFraction": 0.30, // a partir de que fraccion de la tierra emergida hay montanas
  "SnowPeakFraction": 0.80, // y cumbres nevadas (no menor que MountainFraction)
  "TreeDensityMultiplier": 0.5, // 0..5. Multiplica la densidad de arboles de todos los biomas
  "PropDensityMultiplier": 0.5, // 0..5. Multiplica la hierba, flores y rocas (sprites 2D). 0 = sin sprites

  // ---------- JUEGO ----------
  "ViewDistance": 12, // distancia de vision en chunks (2..24). Mucho mayor = muchisimo mas coste
  "FadeChunks": 4, // SHADER DE FUNDIDO: anchura en chunks de la franja donde los bloques se disuelven sobre el terreno lejano (0 = sin fundido; necesita FarDistanceChunks > ViewDistance)
  "FadeInSeconds": 0.5, // 0..3. Lo que tarda en aparecer, disolviendose, un chunk recien construido (0 = aparece de golpe)
  "FarCloseChunks": 10, // DISTANCIA CERCANA del terreno lejano, en chunks: por dentro de ella no hay malla lejana (0 = automatico: ViewDistance)
  "FarDistanceChunks": 36, // DISTANCIA LEJANA (LOD): el relieve aproximado se genera solo entre FarCloseChunks y esta distancia (0 = sin terreno lejano). 64 = 1024 bloques
  "FarDetail": 2.0, // 0.8..4. Mas detalle en la distancia (y mas tiles que generar). Los chunks siguen mandando en su zona
  "Villagers": 20, // aldeanos iniciales alrededor del jugador
  "Caravans": 60, // caravanas repartidas por el mundo
  "EnemiesPerChunk": 0.5, // zombis esperados por columna de chunks al cargarse (0 = sin enemigos). Aparecen lejos del jugador
  "EnemyLimit": 1000, // maximo de zombis en el mundo
  "MapSamplesPerAxis": 3, // precision del mapamundi: muestras por region = n*n (1..16)
  "WorkerThreads": 0, // hilos de fondo para generar y mallar chunks (0 = automatico: nucleos - 2). Sube si te sobran nucleos
  "Cities": {
    "Chance": 0.8, // probabilidad de ciudad por celda de 1024 bloques (0..1)
    "MinRadius": 50, // radio minimo en bloques
    "MaxRadius": 100, // radio maximo
    "MaxSlope": 8, // desnivel maximo del terreno donde se puede levantar una ciudad
    "MaxFloors": 6, // plantas maximas (las torres llegan a esta altura)
    "Villagers": 6, // aldeanos por ciudad
    "Guards": -1, // guardas por ciudad (-1 segun tamano, 0 ninguno)
    "SpecialNpcs": true // mercader, alcalde y herreros
  }
}
