<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<MonoGamePlatform>DesktopGL</MonoGamePlatform>
    <OutputType>Exe</OutputType>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <!-- El GC concurrente reserva memoria extra para el recolector en segundo plano; con tantas mallas grandes (LOH) conviene compactar y devolver memoria -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\GF.World.Voxel\GF.World.Voxel.csproj" />
    <ProjectReference Include="..\..\src\GF.World.Tiles\GF.World.Tiles.csproj" />
    <ProjectReference Include="..\..\src\GF.UI\GF.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compila el contenido (Content/Content.mgcb) durante el build y lo copia junto al ejecutable, en Content/ -->
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="$(MonoGameVersion)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Se edita con el editor de contenido de MonoGame:  dotnet mgcb-editor samples/MiniCraft/Content/Content.mgcb -->
    <MonoGameContentReference Include="Content\Content.mgcb" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="worldsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Tipos de entidad: prototipos, inventarios, equipamiento y variantes -->
    <Content Include="entitytypes.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Objetos: armas, armaduras, pociones, comida... -->
    <Content Include="items.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Tamaños de los sprites en bloques (no es contenido compilado: se copia tal cual a Content/sprites/) -->
    <None Include="Content\sprites\sprites.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
